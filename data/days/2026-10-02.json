                "start": 33,
                "end": 43
              },
              {
                "wordId": "en-8",
                "text": "efficient",
                "start": 53,
                "end": 62
              }
            ]
          },
          {
            "text": "Second, a flexible schedule makes it easier to meet every deadline.",

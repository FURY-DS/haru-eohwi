        "sentences": [
          {
            "text": "天气预报说，周六气温在二十度左右，很适合出门。",
            "reading": "Tiānqì yùbào shuō, zhōuliù qìwēn zài èrshí dù zuǒyòu, hěn shìhé chūmén.",
            "ko": "일기예보에서 토요일 기온이 20도쯤이라 외출하기 아주 좋다고 했어요.",
            "uses": [
              {
                "wordId": "zh-1",
                "text": "预报",
                "start": 2,
                "end": 4
              },
              {
                "wordId": "zh-2",
                "text": "气温",
                "start": 8,
                "end": 10
              }
            ]
          },
          {
            "text": "我们早上七点出发，想到山里体验爬山的乐趣。",
            "reading": "Wǒmen zǎoshang qī diǎn chūfā, xiǎng dào shān lǐ tǐyàn pá shān de lèqù.",
            "ko": "우리는 아침 7시에 출발해서 산에서 등산의 즐거움을 체험하고 싶었어요.",
            "uses": [
              {
                "wordId": "zh-3",
                "text": "出发",
                "start": 6,
                "end": 8
              },
              {
                "wordId": "zh-4",
                "text": "体验",
                "start": 13,
                "end": 15
              }
            ]
          },
          {
            "text": "山上的景色特别美，大家都停下来拍照，当作纪念。",
            "reading": "Shān shàng de jǐngsè tèbié měi, dàjiā dōu tíng xiàlái pāizhào, dàngzuò jìniàn.",
            "ko": "산 위의 경치가 유난히 아름다워서 모두 멈춰서 사진을 찍으며 기념으로 삼았어요.",
            "uses": [
              {
                "wordId": "zh-5",
                "text": "景色",
                "start": 3,
                "end": 5
              },
              {
                "wordId": "zh-6",
                "text": "纪念",
                "start": 20,
                "end": 22
              }
            ]
          },
          {
            "text": "爬到一半，我们觉得有点疲劳，就坐下来吃零食、休息。",
            "reading": "Pá dào yíbàn, wǒmen juéde yǒudiǎn píláo, jiù zuò xiàlái chī língshí, xiūxi.",
            "ko": "중간쯤 올라가자 조금 피곤해서 앉아서 간식을 먹고 쉬었어요.",
            "uses": [
              {
                "wordId": "zh-7",
                "text": "疲劳",
                "start": 11,
                "end": 13
              },
              {
                "wordId": "zh-8",
                "text": "零食",
                "start": 19,
                "end": 21
              }
            ]
          },
          {
            "text": "虽然身体很累，但是心情非常愉快。",
            "reading": "Suīrán shēntǐ hěn lèi, dànshì xīnqíng fēicháng yúkuài.",
            "ko": "몸은 피곤했지만 기분은 아주 즐거웠어요.",
            "uses": [
              {
                "wordId": "zh-9",
                "text": "愉快",
                "start": 13,
                "end": 15

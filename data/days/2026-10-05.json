        "sentences": [
          {
            "text": "上个月，我在网上看到一家公司的招聘信息，决定去应聘。",
            "reading": "shàng ge yuè, wǒ zài wǎngshàng kàndào yì jiā gōngsī de zhāopìn xìnxī, juédìng qù yìngpìn.",
            "ko": "지난달에 저는 인터넷에서 한 회사의 채용 공고를 보고 지원하기로 했어요.",
            "uses": [
              {
                "wordId": "zh-1",
                "text": "应聘",
                "start": 23,
                "end": 25
              }
            ]
          },
          {
            "text": "我认真修改了简历，把自己的优势写得很清楚。",
            "reading": "wǒ rènzhēn xiūgǎi le jiǎnlì, bǎ zìjǐ de yōushì xiě de hěn qīngchu.",
            "ko": "저는 이력서를 열심히 고쳐서 제 강점을 분명하게 적었어요.",
            "uses": [
              {
                "wordId": "zh-2",
                "text": "简历",
                "start": 6,
                "end": 8
              },
              {
                "wordId": "zh-5",
                "text": "优势",
                "start": 13,
                "end": 15
              }
            ]
          },
          {
            "text": "面试那天，我虽然很紧张，但是提前半小时就到了。",
            "reading": "miànshì nà tiān, wǒ suīrán hěn jǐnzhāng, dànshì tíqián bàn xiǎoshí jiù dào le.",
            "ko": "면접 날 저는 많이 긴장했지만 30분 일찍 도착했어요.",
            "uses": [
              {
                "wordId": "zh-3",
                "text": "面试",
                "start": 0,
                "end": 2
              },
              {
                "wordId": "zh-4",
                "text": "紧张",
                "start": 9,
                "end": 11
              }
            ]
          },
          {
            "text": "对方问了很多细节，我都诚实地回答，没有夸大自己。",
            "reading": "duìfāng wèn le hěn duō xìjié, wǒ dōu chéngshí de huídá, méiyǒu kuādà zìjǐ.",
            "ko": "상대방이 세부 사항을 많이 물었고, 저는 모두 솔직하게 대답하며 저를 부풀리지 않았어요.",
            "uses": [
              {
                "wordId": "zh-6",
                "text": "细节",
                "start": 6,
                "end": 8
              },
              {
                "wordId": "zh-7",
                "text": "诚实",
                "start": 11,
                "end": 13
              }
            ]
          },
          {
            "text": "朋友说我的表现很好，这个机会很难得。",
            "reading": "péngyou shuō wǒ de biǎoxiàn hěn hǎo, zhège jīhuì hěn nándé.",
            "ko": "친구가 제 태도가 아주 좋았고 이런 기회는 얻기 힘들다고 말했어요.",
            "uses": [
              {
                "wordId": "zh-8",
                "text": "表现",
                "start": 5,
                "end": 7
              },
              {
                "wordId": "zh-9",
                "text": "机会",
                "start": 12,
                "end": 14
              }

        "grammar": {
          "sentences": [
            {
              "sentence": 1,
              "items": [
                {
                  "pattern": "나는 바람에",
                  "title": "-는 바람에（因为……，结果……）",
                  "explain": "表示因为前面的事，导致后面不好的结果，多用于抱怨或遗憾。“열이 나는 바람에”＝因为发烧（所以没能去学校）。后面不能接命令句和劝诱句。"
                }
              ]
            },
            {
              "sentence": 2,
              "items": [
                {
                  "pattern": "알리니까",
                  "title": "-(으)니까（……之后发现……/因为……）",
                  "explain": "表示做了前面的事之后，得到或发现后面的结果；也可表示原因。“알리니까 물으셨어요”＝我一告知，老师就问了我。前后句的主语通常不同。"
                },
                {
                  "pattern": "참석할 수 있냐고 물으셨어요",
                  "title": "-냐고 묻다（转述疑问句）",
                  "explain": "转述别人的疑问。“참석할 수 있어요?”转述成“참석할 수 있냐고 물으셨어요”。“묻다”是ㄷ不规则，变成“물으셨어요”；-(으)시-是对老师的敬语。"
                }
              ]
            },
            {
              "sentence": 3,
              "items": [
                {
                  "pattern": "오후라서",
                  "title": "-(이)라서（因为是……）",
                  "explain": "名词后加 -(이)라서 表示原因。没有收音用“-라서”，有收音用“-이라서”。“오후라서”＝因为是下午。"
                },
                {
                  "pattern": "가야 할 텐데",
                  "title": "-(으)ㄹ 텐데（应该会……，可是……）",
                  "explain": "表示推测，同时带出担心、遗憾或期待。“가야 할 텐데 걱정이에요”＝我得去才行，真担心。后面常接担心或请求的话。"
                }
              ]
            },
            {
              "sentence": 4,
              "items": [
                {
                  "pattern": "참석하려면",
                  "title": "-(으)려면（想要……的话）",
                  "explain": "表示“如果想做某事的话”，后面接必须做的事。“참석하려면 …제출해야 해요”＝想参加就得提交。有收音用 -으려면。"
                },
                {
                  "pattern": "작성해서",
                  "title": "-아/어서（……之后再……）",
                  "explain": "表示先后顺序，前一个动作完成后接着做后一个动作。“작성해서 제출해야 해요”＝填好之后再提交。"
                },
                {
                  "pattern": "제출해야 해요",
                  "title": "-아/어야 하다（必须……）",
                  "explain": "表示义务或必要性。“제출해야 해요”＝必须提交。过去说“-아/어야 했어요”。"
                }
              ]
            },
            {
              "sentence": 5,
              "items": [
                {
                  "pattern": "적혀 있어서",
                  "title": "被动 적히다 + -아/어 있다（被写着）",
                  "explain": "“적다”（写）的被动形是“적히다”。“적혀 있다”表示写好的状态一直保持着，中文常说“写着”。-아/어서 在这里表示原因。"
                },
                {
                  "pattern": "확인해 두었어요",
                  "title": "-아/어 두다（先做好……）",
                  "explain": "表示为了以后而先做好某事，并保持结果。“확인해 두었어요”＝先确认好了。"
                }
              ]
            },
            {
              "sentence": 6,
              "items": [
                {
                  "pattern": "끝나면",
                  "title": "-(으)면（如果……/……的话）",
                  "explain": "表示条件或假设，也可以表示“一……就……”。“상담이 끝나면”＝面谈结束后（的话）。"
                },
                {
                  "pattern": "가기로 했어요",
                  "title": "-기로 하다（决定……）",
                  "explain": "表示做出决定或约定。“가기로 했어요”＝决定去了。已经决定好的事用过去时“-기로 했어요”。"
                }
              ]
            }
          ],
          "summary": [
            "表示原因：-는 바람에（多用于不好的结果）、-(이)라서（因为是……）。",
            "表示条件和目的：-(으)려면（想要……的话）、-(으)면（……的话）、-아/어야 하다（必须……）。",
            "表示推测、决定与转述：-(으)ㄹ 텐데（应该会……）、-기로 하다（决定……）、-냐고 묻다（转述疑问）。"
          ]
        }
      }
    }

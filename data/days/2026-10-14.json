        "grammar": {
          "sentences": [
            {
              "sentence": 1,
              "items": [
                {
                  "pattern": "도착할 줄 알았던",
                  "title": "-(으)ㄹ 줄 알다（以为会……）",
                  "explain": "表示\"原以为会……（结果不是）\"。用过去形\"-(으)ㄹ 줄 알았다\"时，多含有与预想不同的意思。例：도착할 줄 알았던 택배 = 原以为会到的快递。注意：和\"-(으)ㄹ 수 있다（能够）\"不同。"
                }
              ]
            },
            {
              "sentence": 3,
              "items": [
                {
                  "pattern": "주겠다고 했어요",
                  "title": "-겠다고 하다（说要……）",
                  "explain": "这是间接引语，转述别人说的话或承诺。\"확인해 주겠다\"（会帮您确认）+ \"-고 하다\"= \"说会帮忙确认\"。说话人是转述别人，所以主语常常不是\"我\"。"
                }
              ]
            },
            {
              "sentence": 4,
              "items": [
                {
                  "pattern": "분실되었더라도",
                  "title": "-더라도（即使……也）",
                  "explain": "表示假设一个情况，但后面的结果不受它影响，相当于\"即使……也……\"。분실되었더라도 보상해 드리겠다 = 即使丢失了也会赔偿。比\"-아/어도\"更强调假设。"
                }
              ]
            },
            {
              "sentence": 6,
              "items": [
                {
                  "pattern": "없도록",
                  "title": "-도록（为了不……／以至于）",
                  "explain": "表示目的，相当于\"为了……／让……\"。이런 일이 없도록 = 为了不再发生这样的事。后面通常接请求、要求或努力做的事。注意：不能和\"-게\"完全互换，\"-도록\"更正式。"
                }
              ]
            }
          ],
          "summary": [
            "-(으)ㄹ 줄 알았다：原以为会……，结果和想的不同。",
            "-더라도：即使有这个情况，结果也不变。",
            "-도록：表示目的，\"为了让……／为了不……\"。"
          ]
        }
      }
    }
  }

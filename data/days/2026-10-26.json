        "grammar": {
          "sentences": [
            {
              "sentence": 1,
              "items": [
                {
                  "pattern": "이사하려고",
                  "title": "-(으)려고（为了……；打算……）",
                  "explain": "表示做某事的意图或目的。“이사하려고 부동산에 찾아갔어요”＝为了搬家去了房产中介。注意：后面可以接陈述句和疑问句，但不能接命令句和劝诱句。"
                }
              ]
            },
            {
              "sentence": 3,
              "items": [
                {
                  "pattern": "계약하기로 했어요",
                  "title": "-기로 하다（决定……）",
                  "explain": "表示做出决定或约定。“계약하기로 했어요”＝决定签约了。中文说“决定签约”，韩语用“동사词干＋기로 하다”，不要说成“계약하다고 했어요”。"
                }
              ]
            },
            {
              "sentence": 4,
              "items": [
                {
                  "pattern": "서명하기 전에",
                  "title": "-기 전에（……之前）",
                  "explain": "动词词干加 -기 전에，表示在做某事之前。无论词干有没有收音都用 -기 전에。“서명하기 전에”＝签字之前。"
                },
                {
                  "pattern": "포함되는지",
                  "title": "-는지（是否……）",
                  "explain": "在句子里表示不确定的内容，常和“묻다、알다、확인하다”等一起用。“무엇이 포함되는지 물어봤어요”＝问了包含什么。"
                }
              ]
            },
            {
              "sentence": 5,
              "items": [
                {
                  "pattern": "입주하면",
                  "title": "-(으)면（如果……的话）",
                  "explain": "表示假设或条件。“새 집에 입주하면”＝如果搬进新家的话。有收音用 -으면，没有收音（或ㄹ收音）用 -면。"
                },
                {
                  "pattern": "바쁠 텐데",
                  "title": "-(으)ㄹ 텐데（想必会……，可是……）",
                  "explain": "表示说话人的推测，同时带出后面的内容（担心、遗憾、对比等）。“바쁠 텐데 설레요”＝虽然会很忙，但很期待。"
                }
              ]
            },
            {
              "sentence": 6,
              "items": [
                {
                  "pattern": "돌려받으려면",
                  "title": "-(으)려면（如果想要……的话）",
                  "explain": "表示“如果想做某事”，后面通常接必须做的事或条件。“돌려받으려면 깨끗하게 써야 한다”＝想拿回押金，就得保持干净。"
                },
                {
                  "pattern": "써야 한다고 해서",
                  "title": "-다고 하다（听说……）＋ -아/어서",
                  "explain": "-다고 하다用于转述别人的话。“써야 한다고 해서”＝因为听说必须……。这里 -아/어서 表示原因，“해서”是“하다”的 -아/어서 形式。"
                }
              ]
            }
          ],
          "summary": [
            "目的与决定：-(으)려고（打算）、-기로 하다（决定）、-기 전에（……之前）。",
            "条件与推测：-(으)면（如果）、-(으)려면（想要……的话）、-(으)ㄹ 텐데（想必会……）。",
            "间接内容：-는지（是否）、-다고 하다（听说、转述）。"
          ]
        }

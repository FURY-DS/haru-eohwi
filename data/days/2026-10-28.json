        "sentences": [
          {
            "text": "周末我和朋友去爬山，山里的空气特别新鲜。",
            "reading": "Zhōumò wǒ hé péngyou qù páshān, shānlǐ de kōngqì tèbié xīnxiān.",
            "ko": "주말에 저는 친구와 등산을 갔는데, 산속 공기가 특히 상쾌했어요.",
            "uses": [
              {
                "wordId": "zh-1",
                "text": "爬山",
                "start": 7,
                "end": 9
              },
              {
                "wordId": "zh-2",
                "text": "空气",
                "start": 13,
                "end": 15
              }
            ]
          },
          {
            "text": "路上的风景很美，朋友喜欢摄影，不停地拍照。",
            "reading": "Lùshang de fēngjǐng hěn měi, péngyou xǐhuan shèyǐng, bùtíng de pāizhào.",
            "ko": "길 위의 풍경이 아름다워서, 사진 찍기를 좋아하는 친구는 쉬지 않고 사진을 찍었어요.",
            "uses": [
              {
                "wordId": "zh-3",
                "text": "风景",
                "start": 3,
                "end": 5
              },
              {
                "wordId": "zh-4",
                "text": "摄影",
                "start": 12,
                "end": 14
              }
            ]
          },
          {
            "text": "有些路比较危险，所以我们放慢了速度。",
            "reading": "Yǒuxiē lù bǐjiào wēixiǎn, suǒyǐ wǒmen fàngmàn le sùdù.",
            "ko": "어떤 길은 꽤 위험해서 우리는 속도를 늦췄어요.",
            "uses": [
              {
                "wordId": "zh-7",
                "text": "危险",
                "start": 5,
                "end": 7
              },
              {
                "wordId": "zh-8",
                "text": "速度",
                "start": 15,
                "end": 17
              }
            ]
          },
          {
            "text": "我的体力不太好，走一会儿就要停下来补充水分。",
            "reading": "Wǒ de tǐlì bú tài hǎo, zǒu yíhuìr jiù yào tíng xiàlai bǔchōng shuǐfèn.",
            "ko": "저는 체력이 별로 좋지 않아서, 조금 걷다가 멈춰서 수분을 보충해야 했어요.",
            "uses": [
              {
                "wordId": "zh-5",
                "text": "体力",

                "wordId": "zh-2",
                "text": "着急",
                "start": 11,
                "end": 13
              }
            ]
          },
          {
            "text": "我不知道应该往哪个方向走。",
            "reading": "Wǒ bù zhīdao yīnggāi wǎng nǎge fāngxiàng zǒu.",
            "ko": "어느 방향으로 가야 할지 몰랐어요.",
            "uses": [

                "wordId": "zh-1",
                "text": "突然",
                "start": 10,
                "end": 12
              }
            ]
          },
          {
            "text": "我在路上迷路了，心里很着急。",
            "reading": "Wǒ zài lùshang mílù le, xīnli hěn zháojí.",
